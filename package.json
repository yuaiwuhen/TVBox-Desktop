{
  "name": "tvbox-pc",
  "private": true,
  "version": "0.0.0",
  "author": {
    "name": "TVBox-PC",
    "email": "tvbox-pc@example.com"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "vite build && electron-builder --publish never",
    "build:dir": "vite build && electron-builder --dir --publish never",
    "build:win": "vite build && electron-builder --win --publish never",
    "build:linux": "vite build && electron-builder --linux --publish never",
    "build:mac": "vite build && electron-builder --mac --publish never",
    "build:installer": "vite build && electron-builder --publish never",
    "icon": "node scripts/generate-icon.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "docker:build": "cd docker && docker-compose build",
    "docker:up": "cd docker && docker-compose up -d",
    "docker:down": "cd docker && docker-compose down",
    "docker:logs": "docker logs tvbox-spider",
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@hevcjs/core": "^1.3.1",
    "@types/qrcode": "^1.5.6",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.14.2",
    "hls.js": "^1.5.0",
    "iconv-lite": "^0.7.2",
    "java-bridge": "^2.8.1",
    "localforage": "^1.10.0",
    "node-forge": "^1.4.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "xgplayer": "^3.0.24",
    "xgplayer-flv.js": "^3.0.24",
    "xgplayer-hls.js": "^3.0.24"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "build": {
    "appId": "com.github.tvbox.pc",
    "productName": "TVBox-PC",
    "asar": true,
    "extraResources": [
      {
        "from": "fatcat",
        "to": "fatcat",
        "filter": [
          ".gitkeep",
          "token.txt",
          "kk.txt"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TVBox-PC",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Video"
    }
  }
}